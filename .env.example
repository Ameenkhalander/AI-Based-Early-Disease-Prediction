# Copy to .env and fill in. Loaded by backend/config/settings.py.
# Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/healthcare_assistant

# --- Model artifacts (paths the backend loads at startup) ---
TEXT_MODEL_DIR=./artifacts/text_model
IMAGE_MODEL_LESION_DIR=./artifacts/image_model_lesion
IMAGE_MODEL_GENERAL_DIR=./artifacts/image_model_general
SPEECH_MODEL_SIZE=small          # faster-whisper model size (Phase 11 decision)

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Misc ---
ENVIRONMENT=development
